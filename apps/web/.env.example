# Web env (Next.js 15). Place in apps/web/.env when running `pnpm dev:web`.
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle — only
# put non-secret values here.

# URL of the bot's HTTP sidecar. The /link, /fund, and /admin pages all
# fetch from here. In local dev this is the bot running on port 3001.
NEXT_PUBLIC_BOT_API_URL=http://localhost:3001

# Used both server-side (page server components) and client-side
# (anchor + wallet adapter). For local dev with cloudflared tunnel,
# point at the public devnet RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Base / EVM RPC for the wagmi public client used in /link and /fund
# pages. Defaults to base-sepolia public RPC; swap to a private RPC
# (Alchemy, Quicknode, Coinbase Cloud) for higher rate limits.
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# Server-only: the page server component for /explorer hits this directly
# (NOT NEXT_PUBLIC). Defaults to localhost:3001 if unset; only override if
# the bot runs at a different host inside the deployment network.
BOT_API_URL=http://localhost:3001

# Server-only: ADMIN_API_TOKEN that the web's /api/admin/* proxy uses to
# call the bot's /api/admin/* endpoints. MUST match the bot env. Never
# exposed to the browser.
ADMIN_API_TOKEN=

# Discord OAuth login for /admin/* pages. Register an app at
# https://discord.com/developers/applications, add redirect URI
# `${WEB_PUBLIC_URL}/api/auth/discord/callback`, paste credentials here.
# When unset, the admin page falls back to a "OAuth disabled" message.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Long random string used to HMAC-sign session cookies. Rotate to log
# everyone out. 32+ bytes recommended; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public URL of the web app — used as the OAuth redirect base. In dev
# with cloudflared this is the tunnel URL.
WEB_PUBLIC_URL=http://localhost:3000

# Comma-separated Discord user IDs that may access /admin/* pages.
# Match the bot's ADMIN_DISCORD_IDS exactly.
ADMIN_DISCORD_IDS=
