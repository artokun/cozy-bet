{
  "name": "@cozy-bet/program",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "anchor build && pnpm idl:export",
    "test": "anchor test --skip-local-validator --provider.cluster devnet && pnpm idl:export",
    "test:local": "anchor test && pnpm idl:export",
    "deploy": "anchor deploy --provider.cluster devnet",
    "keys:sync": "anchor keys sync",
    "idl:export": "cp target/idl/escrow.json ../../packages/shared/src/idl.json && cp target/types/escrow.ts ../../packages/shared/src/idl-types.ts",
    "idl:check-sync": "tsx scripts/check-idl-sync.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
