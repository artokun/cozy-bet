# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=                      # filled after `anchor deploy`
MOCK_USDC_MINT=                  # filled after `spl-token create-token`
TREASURY_PUBKEY=                 # printed by scripts/generate-keys.ts
RESOLVER_KEYPAIR_PATH=./keys/bot-resolver.json

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=           # guild to register slash commands in (instant)
DISCORD_GUILD_ALLOWLIST=         # optional: comma-separated guild ids; bot ignores other servers
USER_ALLOWLIST_ENABLED=false     # when true, only discord ids in the `allowlist` DB table can bet
ADMIN_DISCORD_IDS=               # comma-separated discord user ids who can /adminresolve and /reconcile

# Postgres
DATABASE_URL=postgres://cozy:cozy@localhost:5433/cozy_bet

# Web ↔ bot
WEB_PUBLIC_URL=http://localhost:3000   # replace with cloudflared URL when tunneled
BOT_API_PORT=3001
BOT_API_URL=http://localhost:3001
BOT_API_SECRET=change-me-long-random   # HMAC for web→bot callbacks

# Economics
BET_FEE_BPS=250                  # 2.5%

# Watchdog — auto-refund bets stuck in `pending` this long (0 = disabled)
WATCHDOG_PENDING_REFUND_MINUTES=0
WATCHDOG_INTERVAL_SECONDS=120
