# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=http://127.0.0.1:8899   # localnet for dev; switch to https://api.devnet.solana.com for devnet
PROGRAM_ID=nqQkfoyxtzxDBHmyxnJs3KwQVvz5CoFffH8vcQzS6yt
MOCK_USDC_MINT=                  # filled after scripts/mint-mock-usdc.ts
RESOLVER_KEYPAIR_PATH=./keys/bot-resolver.json
ARBITER_KEYPAIR_PATH=             # optional; falls back to RESOLVER_KEYPAIR_PATH

# Treasury — 4 owners receive 0.625% each of every bet's standard fee.
# Solana base58 pubkeys (NOT EVM 0x addresses).
# Run `pnpm tsx scripts/generate-solana-treasury.ts` to populate from local keypairs.
TREASURY_OWNER_1=
TREASURY_OWNER_2=
TREASURY_OWNER_3=
TREASURY_OWNER_4=

# Optional override; if unset, arbiter == resolver (both signed by RESOLVER_KEYPAIR_PATH).
ARBITER_PUBKEY=

# Arbiter fee config (defaults: $100 floor, 1% of pot)
ARBITER_MIN_FEE=100000000
ARBITER_FEE_BPS_OF_POT=100
MIN_DISCOUNTED_FEE_BPS=150       # social-share discount floor (1.5%)

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=           # guild to register slash commands in (instant)
DISCORD_GUILD_ALLOWLIST=         # optional: comma-separated guild ids; bot ignores other servers
USER_ALLOWLIST_ENABLED=false     # when true, only discord ids in the `allowlist` DB table can bet
ADMIN_DISCORD_IDS=               # comma-separated discord user ids who can /adminresolve and /reconcile

# Postgres
DATABASE_URL=postgres://cozy:cozy@localhost:5433/cozy_bet

# Web ↔ bot
WEB_PUBLIC_URL=http://localhost:3000   # replace with cloudflared URL when tunneled
BOT_API_PORT=3001
BOT_API_URL=http://localhost:3001
BOT_API_SECRET=change-me-long-random   # HMAC for web→bot callbacks

# Economics
BET_FEE_BPS=250                  # 2.5%

# Watchdog — auto-refund bets stuck in `pending` this long (0 = disabled)
WATCHDOG_PENDING_REFUND_MINUTES=0
WATCHDOG_INTERVAL_SECONDS=120
WATCHDOG_NUDGE_ENABLED=true      # 24h + 2h pre-deadline DM nudges + stale-arbiter

# Base / EVM — leave the EVM_* vars empty if you don't want to accept Base bets.
EVM_NETWORK=base-sepolia          # base-sepolia | base
EVM_ESCROW_ADDRESS=0xffcC554C4157B9363ab561237e3cc02626775F71
EVM_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
EVM_TREASURY_OWNER_1=0x4Ed9D7BC382e69e262A5415cA52954aAf0ed45d6
EVM_TREASURY_OWNER_2=0x131867e52d0c0c745758254E6F83f4beE4Cb10E9
EVM_TREASURY_OWNER_3=0xA4304Fe0c7eF262747ea4b93de3C587E1080a3b1
EVM_TREASURY_OWNER_4=0x6974CB63b4eC7f0Ca8D431215A18553f21b94c08
RESOLVER_PRIVATE_KEY=             # 0x-prefixed 64-hex; bot signs Base txs with this

# LLM disambig (cozy-bet-4bt) — if unset, /saybet skips disambig and uses
# the user's verbatim description as canonical.
ANTHROPIC_API_KEY=
DISAMBIG_MODEL=claude-haiku-4-5-20251001

# Read-only admin dashboard at /admin/arbiter-cases. Empty = endpoint
# returns 503 (disabled). Set a long random string and share with admins.
# Discord OAuth (cozy-bet-xw5) supersedes this when it lands.
ADMIN_API_TOKEN=

# /share + X (Twitter) verification (cozy-bet-315). When X_BEARER_TOKEN
# is empty, /confirm-share rejects rather than trusting user-submitted URLs.
X_BEARER_TOKEN=
SHARE_HASHTAG=#cozybet            # case-insensitive contains check
SHARE_DISCOUNT_BPS=150            # discount fee bps (matches MIN_DISCOUNTED_FEE_BPS floor)

# Winner-dunk GIF picker (cozy-bet-raz). Newline-delimited "url|label" lines;
# falls back to the hardcoded list in apps/bot/src/dunks.ts when empty.
DUNK_GIFS=

# Web (Next.js public env — these are inlined into the client bundle, so
# only put non-secret values here)
NEXT_PUBLIC_BOT_API_URL=http://localhost:3001
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
