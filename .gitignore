node_modules
.pnpm-store
dist
build
.next
.turbo
.env
.env.local
*.log
.DS_Store

# Secrets & keypairs — never commit
keys/
*.keypair.json

# Anchor — ignore build artifacts but keep the IDL + deploy outputs
# that downstream packages (bot, web, packages/shared) import.
apps/program/target/*
!apps/program/target/idl
!apps/program/target/types
!apps/program/target/deploy
apps/program/target/deploy/*
!apps/program/target/deploy/escrow-keypair.json
!apps/program/target/deploy/escrow.so
apps/program/.anchor
apps/program/test-ledger

# Postgres data
pgdata/

# Local-only docs (chat dumps, scratch notes — not committed)
docs/.local/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
