{
  "name": "cozy-bet",
  "version": "0.0.1",
  "private": true,
  "description": "Discord crypto-escrow betting bot (Solana, multi-chain ingest via aggregator)",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev:bot": "pnpm --filter @cozy-bet/bot dev",
    "dev:web": "pnpm --filter @cozy-bet/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cozy-bet/db migrate",
    "db:studio": "pnpm --filter @cozy-bet/db studio",
    "db:check-schema": "tsx packages/db/scripts/check-schema.ts",
    "program:build": "pnpm --filter @cozy-bet/program build",
    "program:test": "pnpm --filter @cozy-bet/program test",
    "program:test:local": "pnpm --filter @cozy-bet/program test:local",
    "program:deploy": "pnpm --filter @cozy-bet/program deploy",
    "program:idl-check-sync": "pnpm --filter @cozy-bet/program idl:check-sync",
    "bot:abi-check-sync": "pnpm --filter @cozy-bet/bot exec tsx scripts/check-evm-abi-sync.ts",
    "contracts:build": "pnpm --filter @cozy-bet/contracts build",
    "contracts:test": "pnpm --filter @cozy-bet/contracts test",
    "testnet:smoke": "tsx scripts/testnet-smoke.ts",
    "testnet:lifecycle:solana": "tsx scripts/testnet-lifecycle-solana.ts",
    "testnet:lifecycle:base": "tsx scripts/testnet-lifecycle-base.ts",
    "ops:rotate-admin": "tsx scripts/rotate-admin.ts",
    "test:bot": "pnpm --filter @cozy-bet/bot test",
    "test:web": "pnpm --filter @cozy-bet/web test",
    "test:shared": "pnpm --filter @cozy-bet/shared test",
    "test": "pnpm test:shared && pnpm test:bot && pnpm test:web",
    "typecheck:bot": "pnpm --filter @cozy-bet/bot exec tsc --noEmit",
    "typecheck:web": "pnpm --filter @cozy-bet/web exec tsc --noEmit",
    "typecheck": "pnpm typecheck:bot && pnpm typecheck:web"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.48.2",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "viem": "^2.48.4"
  },
  "engines": {
    "node": ">=20"
  }
}
